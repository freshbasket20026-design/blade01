# SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY: Your Supabase project anon/public API key
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# GOOGLE_WEB_CLIENT_ID: Optional Google OAuth Web Client ID for Google Sign-In
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
# ADMIN_USER_ID & ADMIN_PASSWORD: Dedicated Admin Panel credentials (can also be overridden in Secrets)
ADMIN_USER_ID=blade_admin
ADMIN_PASSWORD=BladeAdmin@2026
# GEMINI_API_KEY=MY_GEMINI_API_KEY
